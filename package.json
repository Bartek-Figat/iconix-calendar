{
  "name": "@iconix/calendar",
  "version": "0.1.0",
  "description": "A keyboard-first event calendar for React, Vue and the web: 13 views, event sources (URL, function, .ics feed), drag and drop, background events, range selection, natural-language quick add, command palette, undo/redo, recurring events, resource timeline and .ics import/export. Icons by @iconix/icons, search by @iconix/search.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "default": "./src/vue.js"
    },
    "./element": "./src/element.js",
    "./css": "./src/calendar.css",
    "./calendar.css": "./src/calendar.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "react.d.ts",
    "vue.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./src/element.js"
  ],
  "bin": {
    "iconix-calendar": "./bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test --test-force-exit",
    "test:coverage": "node --test --test-force-exit --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=node_modules/**"
  },
  "keywords": [
    "calendar",
    "event-calendar",
    "scheduler",
    "timeline",
    "react",
    "vue",
    "web-component",
    "drag-and-drop",
    "ics",
    "iconix",
    "resource-timeline",
    "fullcalendar-alternative",
    "time-zones",
    "recurring-events",
    "command-palette"
  ],
  "author": "Bartek Figatowski",
  "license": "MIT",
  "homepage": "https://bartek-figat.github.io/iconix-calendar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bartek-Figat/iconix-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/Bartek-Figat/iconix-calendar/issues"
  },
  "dependencies": {
    "@iconix/icons": "^1.1.1",
    "@iconix/search": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.45"
  },
  "publishConfig": {
    "access": "public"
  }
}
